         <div type="edition" xml:lang="kan-Latn">
             <p>
                 <milestone type="pagelike" n="A" unit="face"/>
                 <lb n="1"/>svasti samasta-bhuvanāśraya
                 <lb n="2" break="no"/>-śrī-prithvī-vallabha-mahā-rājā
                 <lb n="3" break="no"/>dhirāja-paramēśvaraṁ parama
                 <lb n="4" break="no"/>-bhaṭṭārakaṁ satyāśraya kuḷa
                 <lb n="5" break="no"/>-tiḷakaṁ cāḷukyābharaṇaṁ śrī
                 <lb n="6" break="no"/>-mad-āhavamalla-dēvaṁ vija
                 <lb n="7" break="no"/>ya rājyam uttarōttarābhivri
                 <lb n="8" break="no"/>ddhi pravarddamānam ā candrā
                 <lb n="9" break="no"/>rkkaṁ saluttam ire</p>
             
             <p>tat-pāda-pa
                 <lb n="10" break="no"/>dmōpa-jīvi samadhi-gata-pa
                 <lb n="11" break="no"/>ñca-māhā-śabda-mahā-ma
                 <lb n="12" break="no"/>ṇdaḷēśvaraṁ nuḍidante gaṇḍaṁ sa
                 <lb n="13" break="no"/>mara-dhananyaya-vairikuḷā
                 <lb n="14" break="no"/>nktakam ari-ba<supplied reason="omitted">la</supplied>-dhūma-kētu
                 <lb n="15"/>yāhavamalan’ aṁka-kāṟiṁ
                 <lb n="16"/>śrīmatu sōma-permmāḍiyuṁ</p>
           
             <p>
                 <lb n="17"/>tat-kula-vadhuv anavarata-pa
                 <lb n="18" break="no"/>rama-kalyāṇābhy-udaya-saha
                 <lb n="19" break="no"/>śra-phala-bhōga-bhāga-bhāgiṇi dvitī
                 <lb n="20" break="no"/>ya-lakṣmī-samāneyar appa
                 <lb n="21"/>śrīmatu lakṣmib’ arasi
                 <lb n="22" break="no"/>yaru saka-varṣa 895 ne
                 <lb n="23" break="no"/>ya śrīmukha saṁvatsara vai
                 <lb n="24" break="no"/>śākha suddha pañcami guruvāra
                 
                 <milestone type="pagelike" unit="face" n="B"/>
                 <lb n="25"/>kāsavuḷ eḻpataḻ taṟa baḻiya
                 <lb n="26"/>nija-rāja-dhāni koṟapāḻa
                 <lb n="27" break="no"/>l’ āḷuttam</p>
             
             <p>ayya-bibbarasaṁ
                 <lb n="28"/>māḍisida bibbēśvarada prati
                 <lb n="29" break="no"/>ṣṭhā-kāla-nimittaṁ dēva-bhōga
                 <lb n="30" break="no"/>m āgiv' alikoḷanaṁ tribhō
                 <lb n="31" break="no"/>gābhyantara-siddhi-taḷabhōgaṁ ko
                 <lb n="32" break="no"/>ṟapoḻa paḍuva polad’ oḷu
                 <lb n="33"/>kariya nelaṁ mattar· 40
                 <lb n="34"/>kisu kāyi mattar· 13 tā
                 <lb n="35" break="no"/>mare geṟeya peṟage nivē
                 <lb n="36" break="no"/>dyada gaḻde mattar 3 vēmaṇa
                 <lb n="37" break="no"/>yyana keṟeya peṟage
                 <lb n="38"/>gaḻde mattar 13 dammikuṁ
                 <lb n="39" break="no"/>ṭe digginneya gaḻde mattar
                 <lb n="40"/>1 mattar</p> 
                 
            <p>tōṭavuṁ puravuṁ salgu
                <lb n="41"/>kāsiyargge koṟapoḻal ōḷu
                <lb n="42"/>kariya nelaṁ mattar· 4 tāma
                <lb n="43" break="no"/>re geṟeya gaḻde mattar· 3 vēmaṇa
                <lb n="44" break="no"/>yyana keṟeya gaḻde mattar· 4 ki
                <lb n="45" break="no"/>su-kāyi matta 20</p> 
             
             <p>sakaḷa-gō<supplied reason="undefined" evidence="previouseditor">ra</supplied>
                <lb n="46" break="no"/>vaṁge kariya nelaṁ matta <supplied reason="undefined" evidence="previouseditor">6</supplied></p>
             
             <p>pa
                 <lb n="47" break="no"/>ṟekāṟargge kisukāyi matta 3   
                 <lb n="48"/>vēmaṇayyana keṟeya gaḻde ma
                 <lb n="49" break="no"/>tta 5 vaḷikoḷadal kariya gaḻde ne
                 <lb n="50" break="no"/>laṁ matta 60</p> 
             
             <p>gāndharvige mattar·
                 <lb n="51"/>15 gaḻde matta 3</p>
             
             <p>vētrikari
                 <lb n="52" break="no"/>ge kariya nelaṁ mattar· 13</p>
             
             <p>
                 <lb n="53"/>sakaḷa gōravaṁge gaḻde matta 1
                 <lb n="54"/>dammikuṇṭe kariya <supplied reason="lost" evidence="parallel">nelaṁ</supplied>
                 <lb n="55"/>matta 3 <gap reason="lost" unit="character" quantity="7" precision="low"/></p>
             
             <p><milestone type="pagelike" unit="face" n="C"/>
                 <lb n="56"/>int’ ivellamaṁ dhārā-pūrvvakaṁ mā
                 <lb n="57" break="no"/>ḍi koṭṭar tad-dharmma-kaḷasārō
                 <lb n="58" break="no"/>haṇam āgi neṟeya nirvvahisi
                 <lb n="59" break="no"/>dar ggaṁgājaḷa-dhauta-vastra-pavi
                 <lb n="60" break="no"/>trī-kritōttamāṁgeyar appar·</p>
             
             <ab>
                 <lb n="61"/>śrīmad-akkaṁ nālab’ arasiya
                 <lb n="62"/>ru <gap reason="lost" unit="character" quantity="8" precision="low"/></ab>
             
             <p>
                 <lb n="63"/>samadhigata-paṁca-mahā
                 <lb n="64" break="no"/>-śabda-mahāmaṇḍalēśvaraṁ su
                 <lb n="65" break="no"/>bhaṭa-nārāyaṇaṁ kīrti-viḷāsa<supplied reason="undefined" evidence="previouseditor">ṁ</supplied>
                 <lb n="66"/>śrīmat-traiḷokyamalladēva-pā
                 <lb n="67" break="no"/>da-paṁkaja-bhramaraṁ śrīma
                 <lb n="68" break="no"/>t-paṁpa-permānaḍigaḷuṁ</p>
             
             <p>ma
                 <lb n="69" break="no"/>ttaṁ sōma-samudraṁ tāmare
                 <lb n="70" break="no"/>-geṟey ūraṁṇbhak keṟeyoḷa
                 <lb n="71" break="no"/>l’ āge keṟeyoḷuv' akk’ ellaṁ visa
                 <lb n="72" break="no"/>diyaṁ tappad’ ikkuv'</p>
             
             <p>adalli yo
                 <lb n="73" break="no"/>ddhā-bhōvargge sōma-samudrada peṟege
                 <lb n="74" break="no"/>gaḻde matta 3 tāmara-geṟeya
                 <lb n="75" break="no"/>peṟage gaḻde ma 1 bīramayyana
                 <lb n="76" break="no"/>kereya peṟage gaḻde matta 3 ka
                 <lb n="77" break="no"/>riya nelaṁ mattaṁ 30</p> 
             
             <p>yāṇe-gō
                 <lb n="78" break="no"/>saṇe sarv’ annega bāla-vaṇavuṁ
                 <lb n="79"/>para-drammamuṁ koḷasalla <g type="punctuation" ref="sym:doubleBar">.</g></p>
             
             <p>
                 <lb n="80"/>int’ i dharmmamaṁ tappida pratipā
                 <lb n="81" break="no"/>ḷisidava<supplied reason="undefined" evidence="previouseditor">r</supplied>gge kurukṣētradoḷ sata
                 <lb n="82" break="no"/>-kṣētraṁ māḍida phalam akku ta
                 <lb n="83" break="no"/>ppidava<supplied reason="undefined" evidence="previouseditor">r</supplied>gge vārāṇāsoyoḷu kavi
                 <lb n="84" break="no"/>leyan aḍida patakav akku <g type="punctuation" ref="sym:doubleBar">.</g></p>
             
             <p><milestone type="pagelike" unit="face" n="D"/>
                 <lb n="85"/>mad-vaṁśajāṟvaramahīpa
                 <lb n="86" break="no"/>ti vaṁśajāvā pāpādapē
                 <lb n="87" break="no"/>ta manasōbhuvi bhāvi bhūpayē
                 <lb n="88"/>pāḷayanti mama-dharmmam idaṁ sa
                 <lb n="89" break="no"/>mastaṁ <g type="punctuation" ref="sym:doubleBar">.</g></p>
             
             <p>tēṣām mayā viracitām
                 <lb n="90" break="no"/>jaḷirēṣa mūdhni<supplied reason="undefined" evidence="previouseditor">ḥ</supplied> naviṣa Āpami
                 <lb n="91"/>turyadānva viṣam ucyatē viṣa
                 <lb n="92" break="no"/>mē kārinaṁ hanti dēvasya putra-pautrikaṁ <g type="punctuation" ref="sym:bar">.</g></p>
             
             <lg n="1" met="anuṣṭubh" xml:lang="san-Latn">
                 <l n="a"><lb n="93"/>sva-dattaṁ para-dattam vā</l>
                 <l n="b">yo hare<lb n="94" break="no"/>ti <choice><sic>vasuṁdharā</sic><corr>vasuṁdharām</corr></choice></l>
                 <l n="c">ṣaṣṭhir-varṣa-saha<choice><sic>śā</sic><corr>srā</corr></choice><lb n="95"/>ṇi</l>
                 <l n="d">viṣṭhāyāṁ jāyatē <choice><sic>krimi</sic><corr>krimiḥ</corr></choice><g type="punctuation" ref="sym:doubleBar">.</g></l></lg>
             
             <lg n="2" met="anuṣṭubh" xml:lang="san-Latn">
                 <l n="a"><lb n="96"/>bahubhir vvasudhā dattā</l>
                 <l n="b">rābhi<lb n="97" break="no"/>s sagarādhibhi</l>
                 <l n="c">yyasya ya<lb n="98" break="no"/>sya yadā bhūmi</l>
                 <l n="d">tasya tasya<lb n="99"/>tadā phaḷaṁ <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
             <lg n="3" met="śālinī" xml:lang="san-Latn">
                 <l n="a">sāmānyoyaṁ<lb n="100"/>dharma-<choice><sic>sētu</sic><corr>sētur</corr></choice>-nripāṇāṁ</l>
                 <l n="b">kāḷē<lb n="101"/>kālē pāḷanīyō bhavad<choice><sic>bhi</sic><corr>bhiḥ</corr></choice></l>
                 <l n="c"><lb n="102"/>sarvān etāṁ bhāginaṟ pā<lb n="103" break="no"/>rthiveṁ<choice><sic>drā</sic><corr>drān</corr></choice></l>
                 <l n="d">bhūyō bhū<lb n="104" break="no"/>yō yācate rāma<lb n="105" break="no"/>-<choice><sic>bhadra</sic><corr>bhadraḥ</corr></choice><g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>

         
             
             
