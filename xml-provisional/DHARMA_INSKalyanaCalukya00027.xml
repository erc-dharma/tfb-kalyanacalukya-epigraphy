                 <lb n="13" break="no"/>n utpalan udāra<supplied reason="lost" evidence="previouseditor">kāḷapa-seṭṭi</supplied><gap reason="illegible" unit="character" quantity="4"/>gānaṁdade māḍisalke
                 <lb n="14"/>bagedaṁ ke <gap reason="illegible" unit="character" quantity="8"/> daḍe divya-<choice><unclear>taragāvi</unclear><unclear>bhōgārtha</unclear></choice>
                 <lb n="15"/>bhū-vaḷeyadoḷu <gap reason="illegible" unit="character" quantity="4"/>tā<supplied reason="lost" evidence="previouseditor">rama</supplied>ṁtaradol anāvidi                 
                 <lb n="16" break="no"/>māppasunāhama <gap reason="illegible" unit="character" quantity="6"/> nādi kaṇgoḷikukapa
                 <lb n="17" break="no"/>ranā<supplied reason="lost" evidence="previouseditor">dhadindrariṁda sāḷōparivājya</supplied>tālutadārdd' a
