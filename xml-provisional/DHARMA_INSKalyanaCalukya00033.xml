          <div type="edition" xml:lang="kan-Latn" rendition="class:kannada maturity:middle">
              
              <lg n="1" met="anuṣṭubh" xml:lang="san-Latn" rendition="class:kannada maturity:middle">
                  <l n="a"><lb n="1"/><g type="symbol" ref="sym:spiral-right">.</g>namas-tuṅga-śiraś-cuṁbi</l>
                  <l n="b">-candra-cāmara-cārave</l>
                  <l n="c">trailōkya-nagarāraṁbha</l>
                  <l n="d">-mūla-stambhāya <choice><orig>ṣ</orig><reg>ś</reg></choice>aṁbhave <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="2" met="anuṣṭubh" xml:lang="san-Latn" rendition="class:kannada maturity:middle">
                  <l n="a">jayaṁtyā<lb n="2" break="no"/>viṣkr̥taṁ-viṣṇōr</l>
                  <l n="b">vvārāhaṁ kṣōbhitārṇṇavaṁ</l>
                  <l n="c">dakṣiṇōnnata-daṁṣṭrāgraṁ</l>
                  <l n="d">vi<choice><orig>s</orig><reg>ś</reg></choice>rānta-bhuvanaṁ vapu<supplied reason="omitted" evidence="parallel">ḥ</supplied> <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <ab>śr̥</ab>
              
              <p>
                  <lb n="3"/><g type="symbol" ref="sym:spiral-right">.</g>  śrī-<choice><orig>pridh</orig><reg>pr̥th</reg></choice>vī-vallabha-mahārājādhirāja-paramē<choice><orig>s</orig><reg>ś</reg></choice>vara-pa<supplied reason="omitted">ra</supplied>ma-bhaṭṭārakaṁ Uttarōttaram āge tailapa
                  <lb n="4" break="no"/>yyaṁ rājyaṁ geyye <choice><orig>s</orig><reg>ś</reg></choice>aka-varṣa 911 vi<choice><orig>kri</orig><reg>kr̥</reg></choice>tam eṁba saṁvatsara pravarttise Ari-<choice><orig>nri</orig><reg>nr̥</reg></choice>pati-kari
                  <lb n="5" break="no"/>kuṁbhi-kuṁbha-sthaḷa-vinirggata-karavāḷa-vimukti-muktāphaḷō<choice><orig>cchi</orig><reg>cci</reg></choice>ta-samara-saṁghaṭṭaṇa-labdha-vīra vi
                  <lb n="6" break="no"/>jaya-rājya-lakṣmī-vakṣa-staḷa-<choice><sic>di</sic><corr>dri</corr></choice>ṣṭi-viśa-kuḷa-tiḷaka-phaṇā-maṇi-kiraṇa-vibhāsura-nāga-vam<choice><orig>s</orig><reg>ś</reg></choice>ōdbha
                  <lb n="7" break="no"/>va-nāga-dhvaja-pratāpa-vijaya-paḻeghōṣaṇa-vyāghra-lāñ<choice><sic>c</sic><corr>ch</corr></choice>ana-bhōgāvatī-pura-paramē<choice><orig>s</orig><reg>ś</reg></choice>vara-nanni
                  <lb n="8" break="no"/>g’ ā<choice><orig>s</orig><reg>ś</reg></choice>raya-raṇa-raṁga-kēsari-viśiṣṭa-jana-priya Āśrita-jana-kalpa-<choice><orig>vri</orig><reg>vr̥</reg></choice>kṣa pusig’ enippasara<choice><orig>kri</orig><reg>kr̥</reg></choice>ta
                  <lb n="9" break="no"/>maṟimātam anyaja-manōja-sinda-nārāyaṇa nallarge nalla ḍāmara-malla Ēkāṁ<choice><sic>ja</sic><corr>ga</corr></choice>-sūdraka śrī
                  <lb n="10" break="no"/>pulikāla  <g type="punctuation" ref="sym:doubleBar">.</g> 
              </p>
              
              <lg n="3" met="mahāsragdharā">
                  <l n="a"><g type="symbol" ref="sym:spiral-right">.</g>dharaṇēndrēhiśvaraṁ mānava-bhava-nuta-bhū-lōkamaṁ nōrppen end’ ā</l>
                  <l n="b">daradiṁ ta<lb n="11" break="no"/>t-sainyamaṁ piṁtirisi vaniteyuṁ tānum ād’ akkaṟiṁdam</l>
                  <l n="c">bare gar<choice><orig>bhbha</orig><reg>bbha</reg></choice>ṁ tōṟe tad-vallabhege paḍed’ ahiccha<lb n="12" break="no"/>tradoḷu puṭṭidaṁ bhā</l>
                  <l n="d">sura-tējōdbhāsi siṁdhū-nadiya kuṟuvadoḷu siṁdan eṁba kumāra <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              
              
             

