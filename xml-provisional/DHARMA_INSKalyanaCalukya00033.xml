      <body>
          <div type="edition" xml:lang="kan-Latn" rendition="class:kannada maturity:middle">
              
              <lg n="1" met="anuṣṭubh" xml:lang="san-Latn" rendition="class:kannada maturity:middle">
                  <l n="a"><lb n="1"/><g type="symbol" ref="sym:spiral-right">.</g>namas-tuṅga-śiraś-cuṁbi</l>
                  <l n="b">-candra-cāmara-cārave</l>
                  <l n="c">trailōkya-nagarāraṁbha</l>
                  <l n="d">-mūla-stambhāya <choice><orig>ṣ</orig><reg>ś</reg></choice>aṁbhave <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="2" met="anuṣṭubh" xml:lang="san-Latn" rendition="class:kannada maturity:middle">
                  <l n="a">jayaṁtyā<lb n="2" break="no"/>viṣkr̥taṁ-viṣṇōr</l>
                  <l n="b">vvārāhaṁ kṣōbhitārṇṇavaṁ</l>
                  <l n="c">dakṣiṇōnnata-daṁṣṭrāgraṁ</l>
                  <l n="d">vi<choice><orig>s</orig><reg>ś</reg></choice>rānta-bhuvanaṁ vapu<supplied reason="omitted" evidence="parallel">ḥ</supplied> <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <ab>śr̥</ab>
              
              <p>
                  <lb n="3"/><g type="symbol" ref="sym:spiral-right">.</g>  śrī-<choice><orig>pridh</orig><reg>pr̥th</reg></choice>vī-vallabha-mahārājādhirāja-paramē<choice><orig>s</orig><reg>ś</reg></choice>vara-pa<supplied reason="omitted">ra</supplied>ma-bhaṭṭārakaṁ Uttarōttaram āge tailapa
                  <lb n="4" break="no"/>yyaṁ rājyaṁ geyye <choice><orig>s</orig><reg>ś</reg></choice>aka-varṣa 911 vi<choice><orig>kri</orig><reg>kr̥</reg></choice>tam eṁba saṁvatsara pravarttise Ari-<choice><orig>nri</orig><reg>nr̥</reg></choice>pati-kari
                  <lb n="5" break="no"/>kuṁbhi-kuṁbha-sthaḷa-vinirggata-karavāḷa-vimukti-muktāphaḷō<choice><orig>cchi</orig><reg>cci</reg></choice>ta-samara-saṁghaṭṭaṇa-labdha-vīra vi
                  <lb n="6" break="no"/>jaya-rājya-lakṣmī-vakṣa-staḷa-<choice><sic>di</sic><corr>dri</corr></choice>ṣṭi-viśa-kuḷa-tiḷaka-phaṇā-maṇi-kiraṇa-vibhāsura-nāga-vam<choice><orig>s</orig><reg>ś</reg></choice>ōdbha
                  <lb n="7" break="no"/>va-nāga-dhvaja-pratāpa-vijaya-paḻeghōṣaṇa-vyāghra-lāñ<choice><sic>c</sic><corr>ch</corr></choice>ana-bhōgāvatī-pura-paramē<choice><orig>s</orig><reg>ś</reg></choice>vara-nanni
                  <lb n="8" break="no"/>g’ ā<choice><orig>s</orig><reg>ś</reg></choice>raya-raṇa-raṁga-kēsari-viśiṣṭa-jana-priya Āśrita-jana-kalpa-<choice><orig>vri</orig><reg>vr̥</reg></choice>kṣa pusig’ enippasara<choice><orig>kri</orig><reg>kr̥</reg></choice>ta
                  <lb n="9" break="no"/>maṟimātam anyaja-manōja-sinda-nārāyaṇa nallarge nalla ḍāmara-malla Ēkāṁ<choice><sic>ja</sic><corr>ga</corr></choice>-sūdraka śrī
                  <lb n="10" break="no"/>pulikāla  <g type="punctuation" ref="sym:doubleBar">.</g> 
              </p>
              
              <lg n="3" met="mahāsragdharā">
                  <l n="a"><g type="symbol" ref="sym:spiral-right">.</g>dharaṇēndrēhiśvaraṁ mānava-bhava-nuta-bhū-lōkamaṁ nōrppen end’ ā</l>
                  <l n="b">daradiṁ ta<lb n="11" break="no"/>t-sainyamaṁ piṁtirisi vaniteyuṁ tānum ād’ akkaṟiṁdam</l>
                  <l n="c">bare gar<choice><orig>bhbha</orig><reg>bbha</reg></choice>ṁ tōṟe tad-vallabhege paḍed’ ahiccha<lb n="12" break="no"/>tradoḷu puṭṭidaṁ bhā</l>
                  <l n="d">sura-tējōdbhāsi siṁdhū-nadiya kuṟuvadoḷu siṁdan eṁba kumāra <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="4" met="campakamālā">
                  <l n="a"><lb n="13"/>paḍedu vimōhamaṁ pulig’ ahīśvaran ī śi<choice><sic>ṣu</sic><corr>śu</corr></choice>vaṁ surakṣitaṁ</l>
                  <l n="b">naḍapene pann<choice><sic>e</sic><corr>a</corr></choice>gādhipatiyoḷu besa-ve<lb n="14" break="no"/>ttu mahā-mahīśanaṁ</l>
                  <l n="c">naḍapene kumārakaṁ baḷediḷ adhika-<choice><orig>s</orig><reg>ś</reg></choice>auryyada dhīrggha-bāhuvaṁ</l>
                  <l n="d">paḍe<lb n="15" break="no"/>dano sanda sinda-viṣayādhipan unnata-vīra-<choice><orig>s</orig><reg>ś</reg></choice>sana <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="5" met="mattebhavikriḍita">
                  <l n="a">bharadindan niḍu<choice><sic>ḍ</sic><corr>do</corr></choice>ōla sinda-vibhu kay<supplied reason="omitted" evidence="previouseditor">y</supplied>aṁ <lb n="16"/>mucche kaṇṇaṁ kaḍaṁ</l>
                  <l n="b" enjamb="yes">bar adhīśa priyadiṁ tanūbhaveyan īyalu koṁḍutān ā manō</l>
                  <l n="c" enjamb="yes"><lb n="17"/>hareyoḷu krīḍisuttippinaṁ ta<choice><orig>ne</orig><reg>na</reg></choice>yar ādar mūvar ā mūvariṁ</l>
                  <l n="d">pared’ at<supplied reason="omitted" evidence="previouseditor">y</supplied>-unna<lb n="18" break="no"/>ta-sinda-vamśa-mahī<choice><orig>bhri</orig><reg>bhr̥</reg></choice>t-saṁjātar ī lōkadoḷu <g type="punctuation" ref="sym:doubleBar">.</g></l>             
              </lg>
              
              <lg n="6" met="kanda">
                  <l n="a">Ant’ ā mūvatt-onda niś</l>
                  <l n="b" enjamb="yes">ciṁtade bāga<lb n="19" break="no"/>ḍage-nāḍan āḷalu sēvyaṁ</l>
                  <l n="c">kantu-samānaṁ puṭṭid’ a</l>
                  <l n="d" enjamb="yes">nanta-guṇaṁ negardda sindan e<supplied reason="omitted" evidence="previouseditor">ṁ</supplied>ba kumā<lb n="20" break="no"/>ra <g type="punctuation" ref="sym:doubleBar">.</g></l> 
              </lg>
              
              <lg n="7" met="kanda">
                  <l n="a">niḍu-doḷa sindaniṁ tān</l>
                  <l n="b">eḍev aṟiyade baṁda sindarānvāyaṁ bā</l>
                  <l n="c" enjamb="yes">gaḍageya<lb n="21"/>siṁdarin esedadu</l>
                  <l n="d">poḍaviyoḷ ene negarddan alte kammaran eṁba <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="8" met="kanda">
                  <l n="a">dhare pogaḷe nega<lb n="22" break="no"/>ḷda kammayy’</l>
                  <l n="b" enjamb="yes">arasaṁgam anūna-vidita-guṇa-gaṇa-<choice><orig>si</orig><reg>śi</reg></choice>lā</l>
                  <l n="c" enjamb="yes">bharaṇ<choice><orig>a</orig><reg>ā</reg></choice>-bhūṣita sagarabb’</l>
                  <l n="d" enjamb="yes">arasiga<lb n="23" break="no"/><supplied reason="lost">m a</supplied>sam eseye puṭṭidaṁ pulikāla <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="8" met="kanda">
                  <l n="a">pulikāla-<choice><orig>nri</orig><reg>nr̥</reg></choice>patiga<supplied reason="omitted" evidence="previouseditor">ṁ</supplied></l>
                  <l n="b">śrī-lalanege dorey enipa<lb n="24"/>rēvakkabbegam ādaṁ</l>
                  <l n="c"><supplied reason="lost" evidence="previouseditor">sale</supplied>sad-guṇade su-putra<supplied reason="omitted" evidence="previouseditor">ṁ</supplied></l>
                  <l n="d">kuḷa-dīpakan enisi puṭṭida nāgātya-<choice><orig>nri</orig><reg>nr̥</reg></choice>pa <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="9" met="kanda">
                  <l n="a"><lb n="25"/>kali-nāgāditya-<choice><orig>nri</orig><reg>nr̥</reg></choice>paṁgaṁ</l>
                  <l n="b">poleyabbarasigam anūna-guṇa-gaṇa-niḷayaṁ</l>
                  <l n="c">kuḷam ese<lb n="26" break="no"/><choice><sic>E</sic><corr>ye</corr></choice> puṭṭidaṁ śrī</l>
                  <l n="d">-polasiṁda<supplied reason="omitted" evidence="previouseditor">ṁ</supplied>siṁda-vam<choice><orig>sa</orig><reg>śa</reg></choice>-tilakaṁ dhareyoḷu <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="10" met="utpalamālā">
                  <l n="a">khāṇḍava-maṇḍalē<choice><orig>sva</orig><reg>śva</reg></choice>ra-tanū<lb n="27" break="no"/>bhave Bijjaladēvi tāyi ja</l>
                  <l n="b" enjamb="yes">gan-maṇḍa<supplied reason="lost" evidence="previouseditor">na</supplied>n ādi-rāja-caritaṁ phaṇi-kētana<supplied reason="lost" evidence="previouseditor">n a</supplied>nya-rāja-vē</l>
                  <l n="c" enjamb="yes">daṇḍa-<choice><orig>si</orig><reg>śi</reg></choice>raṣ-ka<lb n="28" break="no"/>raṁṇḍan avamuktaka-bhūpane taṁde siṁda-mār</l>
                  <l n="d" enjamb="yes">ttaṁdan enalk’ idan bhaya-pakṣa-vi<choice><orig>su</orig><reg>śu</reg></choice>ddhano sē<lb n="29" break="no"/>vya-bhū-bhuja <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <p>svasti samadhi-gata-paṁca-mahāśabda-mahāmaṁḍalēśvara bhōgāvati-puravarā
                  <lb n="30" break="no"/>dhīśvaran ahicchitrapura-dharāmara-rakṣa-dakṣa-dakṣiṇa-bhuja-daṁḍa siṁda-mārttaṁḍan anē
                  <lb n="31" break="no"/>ka-śastra-śāstra-pārāvāra-pārāyaṇaṁ mūrtti-nārā<supplied reason="omitted" evidence="previouseditor">ya</supplied>ṇa hara-caraṇa-smaraṇa-pari
                  <lb n="32" break="no"/>ṇatāṁtaṣ-karaṇa-parama-māhēśvaraṁ phaṇi-patākēśvaraṁ ripu-maṁḍalika-daitya-vilayakara
                  <lb n="33" break="no"/>ṇa-pariṇatōpēṁdra-nara-svarūpa-nāgēṁdra-sakaḷa-kaḷā-kaḷita-vā<gap reason="lost" unit="character" quantity="1"/>lanā-līlā-lalā
                  <lb n="34" break="no"/>ma-bhuja-baḷa-bhīma-bhuvanaikamalla-dēva-caraṇa-kēḷī-durllaḷita-kalahaṁsa-siṁda-vamśōttaṁ
                  <lb n="35" break="no"/>sa-sāhitya-vidya-vivēka-viriṁcana-vyāghra-lāṁcchana-siṁda-vi<choice><orig>śa</orig><reg>ṣa</reg></choice>yādhirāja-sahaja-rūpa
                  <lb n="36"/>-manōja-trailōkya-varttita-kīrtti-pātāḷa-cakravartti-vi<choice><orig>dha</orig><reg>da</reg></choice>gdha-vibhuda-jana-stutyan abhinava-vi
                  <lb n="37" break="no"/>kramāditya-karavāḷa-vidyā-sahadēva-kaṭakada gōvaṁ śrīman-mahāmaṇḍalēśvara prabhu-sēvy’ a
                  <lb n="38" break="no"/>rasaru <g type="punctuation" ref="sym:doubleBar">.</g>
              </p>
              
              <p>svasti samadhi-gata-pa<supplied reason="omitted" evidence="previouseditor">ṁ</supplied>ca-mahāśabda-mahāsāmanta ripu-<choice><orig>nri</orig><reg>nr̥</reg></choice>pati-kari-kuṁbhi-kuṁ
                  <lb n="39" break="no"/>kuṁbha-sthaḷa-vidā<choice><orig>ru</orig><reg>ra</reg></choice>nāruṇita-karavāḷa-<choice><orig>sō</orig><reg>śō</reg></choice>bhita-dakṣiṇadōrddaṁḍan ubhaya-baḷa-gaṁ
                  <lb n="40" break="no"/>ḍa Ari-<choice><orig>nri</orig><reg>nr̥</reg></choice>pa-saṁhāra-kāraṇa-kuḷika <choice><orig>dri</orig><reg>dr̥</reg></choice>ṣṭi-viṣakuḷa-tiḷaka-suvarṇṇa-cchatra-traya-bhū
                  <lb n="41" break="no"/>ṣaṇa vijaya paṟeghōṣaṇa bhōgāvati-puravarē<choice><orig>sva</orig><reg>śva</reg></choice><supplied reason="lost" evidence="previouseditor">ra</supplied>n a
                  <supplied reason="lost" evidence="previouseditor">na</supplied>nta-vāsugi-takṣaka-phaṇi-patākē<choice><orig>sva</orig><reg>śva</reg></choice>ra vyā
                  <lb n="42" break="no"/>ghra-lāṁcchana-manōja siṁdha-viṣayādhirāja sakaḷa-bhuvana-bhavana-pa<supplied reason="lost" evidence="previouseditor">ra</supplied>-<choice><orig>nri</orig><reg>nr̥</reg></choice>pa-vanitā-jana-kaṁḍa
                  <lb n="43" break="no"/>n akaḷaṁka-siṁda siṁda-kuḷa-tiḷaka śrī-nāgāditya <g type="punctuation" ref="sym:doubleBar">.</g>
              </p>
              
              <p>svasti yama-niyama-svādhyāya-<choice><orig>mō</orig><reg>mau</reg></choice>nādhyānānu
                  <lb n="44" break="no"/>ṣṭhā<choice><orig>ṇa</orig><reg>na</reg></choice>-pārāyaṇar appa para-traya-siṁha-rā<choice><orig>si</orig><reg>śi</reg></choice>-bhaṭṭarargge uttarāyaṇa-samkrānti-<choice><orig>ya</orig><reg>vya</reg></choice>tipāta
                  <lb n="45"/>Aditya-vārad’ aṁdu pattiya-mattaUrada daṁḍinolu kiṟiya-siriUrada sāyira mattar ppola
                  <lb n="46" break="no"/>a<supplied reason="omitted" evidence="previouseditor">ṁ</supplied> siṁdē<choice><orig>sva</orig><reg>śva</reg></choice>ra-dēvargge nāgātiyarasa paratraya-siṁharā<choice><orig>si</orig><reg>śi</reg></choice>gaḷa 
                  kāla<supplied reason="omitted" evidence="previouseditor">ṁ</supplied> karcchi koṭṭa ant’ ā sāyi
                  <lb n="47" break="no"/>ra mattargiṁg’ aruvaṇa gadyāṇa hanneraḍu <supplied reason="lost" evidence="previouseditor">b</supplied>rahma<supplied reason="lost" evidence="previouseditor">cā</supplied>ryyaṁ-uḷḷuvaru sthānaṁ āḷvaru</p>
              
              <p>ī dha
                  <lb n="48" break="no"/>rmmamaṁ kādataṁge gaṁge gaye varaṇāsiy<supplied reason="lost" evidence="previouseditor">oḷu sā</supplied>yira kavileya kōḍuṁ kolagumaṁ poṁ
                  <lb n="49" break="no"/>noḷ kaṭṭisi sāsirvva<supplied reason="lost" evidence="previouseditor">r</supplied>-ttapōdhanar<supplied reason="lost" evidence="previouseditor">ggaṁ</supplied> cat<supplied reason="lost" evidence="previouseditor">urvvēda-pārāya</supplied>ṇarigaṁ koṭṭa phala
              </p>
             
             <p>ī dharmmamaṁ pūṇḍaḷidavaṁge sa
