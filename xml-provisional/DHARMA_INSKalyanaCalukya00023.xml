      <body>
         <div type="edition" xml:lang="kan-Latn">
             
             <lg n="1" met="anuṣṭubh" xml:lang="san-Latn">
                 <l n="a"><lb n="1"/><supplied reason="lost" evidence="parallel">śubham</supplied> bhūyāj jinēndrāṇā<supplied reason="lost" evidence="parallel">ṁ</supplied></l>
                 <l n="b">śāsanāyāgha-nāśinē </l>
                 <l n="c">ku<supplied reason="lost" evidence="parallel">tīrttha</supplied>-dhvānta-saṁghāta</l>
                 <l n="d" enjamb="yes">-prabhinna-<supplied reason="lost" evidence="parallel">ghana-bhānavē</supplied> <supplied reason="lost"><g type="punctuation" ref="sym:doubleBar">.</g></supplied></l>
             </lg>
             
             <lg n="2" met="śārdūlavikrīḍita" xml:lang="san-Latn">
                <l n="a">śrīmad-rāma-ma<supplied reason="lost">hīṁ</supplied><lb n="2" break="no"/>dra-datta-sakaḷa-kṣōṇī-vadhū-maṇḍanē</l> 
                <l n="b">sākṣāt kōkanadāsanēna sadṛśaṁ brahmātmajais sēvitē</l> 
                <l n="c">śumbhat-tōyaja-nābha-pattana-nibhē <lb n="3"/> śrī-lokkiguṇḍyāhvayē</l>
                <l n="d">jaina-sthānam acīkarad guṇa-nidhiḥ śrī-dāna-cintāmaṇiḥ <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
             <lg n="3" met="upajāti" xml:lang="san-Latn">
                 <l n="a">cāḷukya-cakri-dhvajinīpa-mātrā</l>
                 <l n="b" enjamb="yes">samarppitaḥ kā <lb n="4" break="no"/> rita-jaina-gēhaḥ</l>
                 <l n="c">śrī-lokkiguṇḍyā<supplied reason="omitted">ḥ</supplied> paripāḷanārthaṁ</l> 
                 <l n="d">sahasra-saṁkhyeṣu dharāmarēṣu <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
            <p>
                <lb n="5"/><g type="symbol" ref="sym:spiral-spoked"/>svasti samasta-bhuvanāśraya-śri-pṛthvī-vallabha-mahārājādhirāja-paramēśvara-paramabhaṭṭāraka-satyāśraya-kuḷatilaka-cāḷukyābha
                <lb n="6" break="no"/>raṇa-śrīmad-āhavamalla-dēvara rājyam uttarōttarābhivṛddhi-pravar<choice><sic>dd</sic><corr>dh</corr></choice>amānam ā candrārka-tārambaram saluttam ire tat-pāda-padmōpajīviyu
                <lb n="7" break="no"/>m akhila-rājyabhara-ṇirūpita-mahā-mantrākṣa-paṭaḷādhipatiyum enisi <g type="punctuation" ref="sym:doubleBar">.</g></p> 
             
             <ab>kanda <g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <lg n="4" met="kanda">
                <l n="a">mallāmalliyoḷ āntari</l>
                <l n="b" enjamb="yes">mallaran āhavadoḷ ottigō<lb n="8" break="no"/>ḷ marigoḷv’ ī</l>
                <l n="c">ballāḷtanadind’ āhava</l>
                <l n="d" enjamb="yes">mallana bhuja-daṇḍam enisi <choice><sic>dhaṁllaṁ</sic><corr>dhallaṁ</corr></choice> negaḻdam <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>            
            
            <ab>vr̥tta<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <lg n="5" met="campakamālā">
                 <l n="a">poṇardd’ idir āgi tāgi doran' āneyoḷ okkuvan andu bercce koṁ</l>
                 <l n="b" enjamb="yes"><lb n="9" break="no"/>kaṇam eḻdiyikke beṁgi beṟagāge tivuḷḷelan' aḷke māḷava</l>
                 <l n="c" enjamb="yes">maṇiyi podaḷdudirkkelade munddaṇa sindaṇa-maṇḍalakke bhī</l>
                 <l n="d" enjamb="yes">ṣaṇam atiraudram a <lb n="10" break="no"/>dbhutam agurvvine tējadaḷ urkke dhallana<g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
             <ab>kanda <g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <lg n="6" met="kanda">
                 <l n="a">dhallana negaḻd' āhava</l>
                 <l n="b" enjamb="yes">mallaṁgaṁ bhēdam uṇṭe vibhavadoḷ adan ēn</l>
                 <l n="c" enjamb="yes">ellarum aṟiyar dharaṇī</l>
                 <l n="d" enjamb="yes">-valla<lb n="11" break="no"/>bha siṁhāsanaika-bhēdame bhēda<supplied reason="omitted">ṁ</supplied><g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
             <ab>va<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <p> antu maṇḍaḷa-siddhiyum vivēka-br̥haspatiyum enisi negaḻda dhallana piriya magaṁ</p>
             
             
             <ab>vr̥<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <lg n="7" met="mattebhavikrīḍita">
                 <l n="a"> bharadiṁ <lb n="12"/>rāvaṇa-sēneyaṁ tavisi geld' ā gaṇḍaruṁ bhaṇḍaṇā</l>
                 <l n="b" enjamb="yes">jiradoḷ kaurava-sēneyam tuḷidu geld' ā gaṇḍaruṁ gaṇḍa-ma</l>
                 <l n="c" enjamb="yes">ccaradiṁ śaktiya bīraraṁ <lb n="13" break="no"/> ponaḻdu geld' ā gaṇḍaruṁ vīta-mat</l>
                 <l n="d" enjamb="yes">saradiṁ bhāvisuv' āgaḷ' ī samarakoḷ gaṇḍaṁ baraṁ gaṇḍarē <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
             <ab>va<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <p>Ā vāji-kuḷa-tiḷakanuṁ tējō-bhāskaranuṁ
             <lb n="14"/>vīra-triṇētranuṁ nanni-mahārṇnavanuṁ kanduka-purandaranum enisuva vīrāgraṇiya parākramamē dorentene</p>
             
             <ab>vr̥<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <lg n="8" met="utpalamālā">
                 <l n="a">dhāḷiyo<lb n="15" break="no"/>ḷ andhranaṁ piḍidapeṁ magadhēśanan ikki meṭṭipeṁ</l>
                 <l n="b">lāḷana gaṇṭalaṁ muridapeṁ khasanaṁ puḍiyoḷ poraḷcapeṁ</l>
                 <l n="c">kōḷadoḷ ikkipeṁ maleva pā<lb n="16" break="no"/>ṇḍyanan āhavamalla-dēvaniṁ</l>
                 <l n="d">pēḷ enutirppan ī doretu śaurya-guṇōnnati nāgadēvana <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
             <ab>va<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <p>ā mahīdēva-kuḷa-gagana-gabha
             <lb n="17" break="no"/>sti-māḷige mahā-satī-ratnaṁ kuḷa-patniy' āgi guṇad' aṁka-kārtiyuṁ kavivara-kāmadhēnumuṁ kaṭaka-pavitreyuṁ ji
             <lb n="18" break="no"/>na-dharmma-patākeyum enisida dāna-cintāmaṇiya mahā-prabhāvamē dōrentene <g type="punctuation" ref="sym:doubleBar">.</g></p>
             
             <ab>vr̥<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
             <lg n="9" met="utpalamālā">
                 <l n="a">unnata-kukkuṭēśvara-jinēśvaranaṁ <lb n="19"/> jina-bhakti pōgi kāṇ</l>
                 <l n="b" enjamb="yes">b' annegam annamaṁ toṟedu parvvatamaṁ mudadēṟe taj-jinā</l>                 
                 <l n="c" enjamb="yes">sannadoḷ attiyabbege patha-śramam ād' ōḍ’ akāḷa-vṛṣṭi<lb n="20"/>y āy</l> 
                 <l n="d" enjamb="yes">t’ innavu dēva-bhaktig’ adu cōdyame koḷḷave puṣpa-vṛṣṭigaḷ <g type="punctuation" ref="sym:doubleBar">.</g></l></lg>
             
             <lg n="10" met="kanda">
                 <l n="a">narapana besadiṁ jinanaṁ</l>
                 <l n="b">śiradoḷ sale tāḷdi dānacintāmaṇi nir</l>
                 <l n="c" enjamb="yes">bbha<lb n="21"/>ra gōdāvariyaṁ puge</l>
                 <l n="d">pariyuḍugidud’ eṁdoḍ’ oḷvan’ adenē vēḷveṁ <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>
             
             <lg n="11" met="kanda">
                 <l n="a">madavat kari seṟeyaṁ paḻi</l>
                 <l n="b" enjamb="yes">d' odavida muḷisinde bhōreney taṁdoḍ' adar</l>
                 <l n="c" enjamb="yes">kk' ad' i<lb n="22" break="no"/>radire bhaktiyiṁd' adu</l>
                 <l n="d" enjamb="yes">padayuga keḻag' idudu dānacintāmaṇiya <g type="punctuation" ref="sym:doubleBar">.</g></l>
             </lg>

           <lg n="12" met="kanda">
               <l n="a">mudad' arcccipa jina-bimbaṁ</l>
               <l n="b">nadiyoḷ key bardduki biḻdoḍ' adu bappinam u<lb n="23" break="no"/>ṇ</l>
               <l n="c" enjamb="yes">b' adan uḷid' iral enṭu dinakk'</l>
               <l n="d" enjamb="yes">adu bandudu kayge dānacintāmaṇiya <g type="punctuation" ref="sym:doubleBar">.</g></l>
           </lg>
             
           <lg n="13" met="kanda">
               <l n="a">praḷeyāgniyante kaṭakama</l>
               <l n="b" enjamb="yes">n oḷakoṇḍaḷ urvvagni dānacintāma<lb n="23" break="no"/>ṇi nir</l>
               <l n="c" enjamb="yes">mmaḷa-jana-gandhōdakamaṁ</l>
               <l n="d">taḷiyal kupa śamisit' endoḍe vaṇṇisuve <g type="punctuation" ref="sym:doubleBar">.</g></l>
           </lg>
             
          <lg n="14" met="kanda">
              <l n="a">oḍanēṟe savati noṁkal</l>
              <l n="b">k' oḍarise toṟeyoḷage paḻugala<lb n="25"/>ttittalaṇaṁ</l>
              <l n="c">miḍukade tiriyuttire kaṇ</l>
              <l n="d" enjamb="yes">ḍaḍig' eṟagidaḷ attiyabbe-sati-bhaya-vaśadiṁ <g type="punctuation" ref="sym:doubleBar">.</g></l>
          </lg>
             
         <lg n="15" met="kanda">
             <l n="a">jina-dharma-patākege vima</l>
             <l n="b" enjamb="yes">ḷa-narmadā-nadiya <lb n="26"/><supplied reason="lost"><choice><unclear>ku</unclear><unclear>ka</unclear></choice></supplied>ruḷapāveya jinanaṁ</l>
             <l n="c">vinutaṁ kāṇb' inegaṁ kū</l>
             <l n="d" enjamb="yes">ḷane toṟedudu sandud' antad' ā janmāntaṁ <g type="punctuation" ref="sym:doubleBar">.</g></l>
         </lg>
             
        <ab>vr̥<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
        <lg n="16" met="campakamālā">
            <l n="a">jina-pada-paṁkaja-bhramaran emba negartteya<lb n="27" break="no"/>n āḷda mallapa</l>
            <l n="b" enjamb="yes">yyana negaḻd’ appakabbeya magaḷ śacivōttaman appa dhallapa</l>
            <l n="c" enjamb="yes">yyana sose nāgadēvana kuḷāṁgane tailana tāyjasakke bhā</l>
            <l n="d" enjamb="yes">janam e<lb n="28" break="no"/>nim attimabbe jina-śāsanamaṁ beḷaguttam iḻdapaḷ <g type="punctuation" ref="sym:doubleBar">.</g></l>
        </lg>
             
        <lg n="17" met="campakamālā">
           <l n="a">eṇe marudēvi pāsaṭi suṣēṇi samaṁ śivadēvi pāṭi lak</l>
           <l n="b" enjamb="yes">ṣaṇe sadṛśam mahā-vijaya<lb n="29" break="no"/>sēne samāne susīḷe pōlva rug</l>
           <l n="c" enjamb="yes">miṇi sari satyabhāme toṇe mikka suḷocane tatsvarūpe rō</l>
           <l n="d" enjamb="yes">hiṇi dore saṁd’ arundhati peṟaṟ do<lb n="30" break="no"/>reye guṇad’ ankakārtiyoḷ</l>
        </lg>
             
        <lg n="18" met="mattebhavikrīḍita">
            <l n="a">parama-śrī-jina-nātha-gēha-viḷasac-chaṁdōha-saṁdōha-bhā</l>
            <l n="b" enjamb="yes">sura-jaina-pratimā vicitra-maṇi-ghaṁṭā<lb n="31" break="no"/>māḷikā-saṁkhe sā</l>
            <l n="c" enjamb="yes">yirad-aynūṟ' ivu bēḻaveṟinipinaṁ nirmmāpaṇaṁ geydu bhū</l>
            <l n="d" enjamb="yes">-bharadoḷ dharman atimabbeyavol int’ ār ujvaḷaṁ<lb n="32" break="no"/> māḍidar <g type="punctuation" ref="sym:doubleBar">.</g></l>
        </lg>
             
        <ab>kaṁ<g type="punctuation" ref="sym:doubleBar">.</g></ab>
        
        <lg n="19" met="kanda">
            <l n="a">ā paramēśvarige jagad</l>
            <l n="b" enjamb="yes">-vyāpaka-śuddhēndu-kīrtti piriya magaṁ lakṣ</l>
            <l n="c" enjamb="yes">mī-pati-samagra-vijaya</l>
            <l n="d" enjamb="yes">-śrī-patiy' ene dharege nega<lb n="33" break="no"/>ḻda paḍavaḷa tailaṁ <g type="punctuation" ref="sym:doubleBar">.</g></l>
        </lg>
             
        <lg n="20" met="campakamālā">
            <l n="a">pagaraṇamaṇma meccu panighṛṣṭiye būdiyi<supplied reason="omitted">ṁ</supplied> boṭṭu gaṇḍav’ ā</l>
            <l n="b" enjamb="yes">tugibagi-kīrti-kuppakuṟi muttara modale peṁ<lb n="34" break="no"/>pu vikramaṁ</l>
            <l n="c">bhagavatiyēṟu śauca-guṇam attiya-paṇnenipēḷa-puṇḍaraṁ</l>
            <l n="d">tegaḷvudud’ āra cāru-carita-prabheyiṁ paḍevaḷḷa tailana <g type="punctuation" ref="sym:doubleBar">.</g></l>
        </lg>
             
        <ab>va<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
        <p>
        <lb n="35"/>Intu nanni-nārāyaṇaṁ samyaktva-ratnākaraṁ patimecce-gaṇḍan āḷdana-cakraṁ <choice><sic>karppvūra</sic><corr>karpūra</corr></choice>-varṣam catura-caturānanaṁ guṇa-mēru-vāyidhā
        <lb n="36" break="no"/>cāryan eṁba nāma-māḷe dig-vadhū-dhammellam āḷe yenisi śrīmat-vaḍevaḷḷa-tailapayyaṁ māsavāḍi <num value="140">nuṟanālvattumaṁ</num> bēḷavṛ
        <lb n="37" break="no"/>ttiyin āḷuttamire <g type="punctuation" ref="sym:doubleBar">.</g></p>
             
        <ab>vr̥<g type="punctuation" ref="sym:doubleBar">.</g></ab>
             
      <lg n="20" met="mahāsragdharā">
         <l n="a">viḷasad-bhūdēva-vēda-dhvani-samucita-dharmmārttha-śāstrārtthava-nnir</l>
         <l n="b" enjamb="yes">maḷa-dharmmārtthōkti-nānā-janapada ja<supplied reason="lost">na</supplied>
