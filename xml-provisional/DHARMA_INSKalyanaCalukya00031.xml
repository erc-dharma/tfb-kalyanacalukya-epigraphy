          <div type="edition" xml:lang="kan-Latn" rendition="class:kannada maturity:middle">
              <p>
                  <lb n="1"/><supplied reason="lost" evidence="previouseditor">svasti sama</supplied><supplied reason="lost" evidence="parallel">sta-bhuvanāśraya śrī-pr̥thvī-vallabha-mahārājādhirāja paramēśvara</supplied>
                  <lb n="2"/>-parama-bhaṭṭāraka-satyā<supplied reason="lost" evidence="parallel">śraya-kula-tilaka-śrīmad-āhavamalla-dēvara</supplied>
                  <lb n="3"/>rājyaṁ uttarōttarābhivr̥<supplied reason="lost" evidence="parallel">ddhi</supplied>
                  <lb n="4"/>mahā-mantrākṣa-paṭa<gap reason="lost" unit="character" quantity="15"/>
              </p>
              
              <ab><lb n="5"/>kanda <g type="punctuation" ref="sym:bar">.</g></ab>
              
              <p>āhavamallana <supplied reason="lost" evidence="previouseditor">caraṇa</supplied> 
                  <lb n="6"/>diṁ sanda nāgadēvana maga<gap reason="lost" unit="character" quantity="14"/>
                  <lb n="7" break="no"/>sida nāgadēvana magaṁ <g type="punctuation" ref="sym:doubleBar">.</g>
              </p>
              
              <p><gap reason="lost" unit="character" quantity="13"/>
                  <lb n="8"/>dharmmaṁ janakan’ aṁkada dhallana nandana <gap reason="lost" unit="character" quantity="9"/>
                  <lb n="9"/>guṇad’ aṁka-kārti mikk’ attimabbe<supplied reason="lost" evidence="previouseditor">ya</supplied><gap reason="lost" unit="character" quantity="11"/>
                  <lb n="10"/>ndan’ alte <g type="punctuation" ref="sym:bar">.</g>
              </p>
              
              <p>intu samasta-rājya <gap reason="lost" unit="character" quantity="12"/>
                  <lb n="11" break="no"/>ra karppūra-varṣa-catura-caturānana<gap reason="lost" unit="character" quantity="8"/>
                  <lb n="12"/>vāḍi <num value="140">nūṟa-nālvattu</num>v'aḻita-vr̥ttiyind’ āḷlutta<supplied reason="lost" evidence="parallel">m ire</supplied><gap reason="lost" unit="character" quantity="4"/>
              </p>
                  
              <lg n="1" met="campakamālā">
                   <l n="a"><supplied reason="lost" evidence="parallel">jina-pada-paṁkaja-bhramara</supplied><lb n="13"/>ran eṁba negaḻteyan ānta mallapa</l>
                   <l n="b" enjamb="yes">yyana negaḻd’ appa<supplied reason="lost" evidence="parallel">kabbeya magaḷ śacivōttaman appa dhalla<lb n="14" break="no"/>ppa</supplied></l>
                   <l n="c" enjamb="yes">yana sose nāgadēvana <choice><sic>kaḷāṁgane</sic><corr>kuḷāṁgane</corr></choice> tailana tāy jasakke<supplied reason="lost" evidence="parallel">bhā</supplied></l>
                   <l n="d" enjamb="yes"><supplied reason="lost" evidence="parallel">janam enim attimabbe jina</supplied><lb n="15"/>-śāsanamaṁ beḷaguttam iṟdapaḷ <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <p>intu jina-dharmma-patākeyuṁ <supplied reason="lost" evidence="previouseditor">kaṭaka</supplied><supplied reason="lost" evidence="parallel">-pavitreyum</supplied><gap reason="lost" unit="character" quantity="2"/> 
                  <lb n="16"/><supplied reason="lost" evidence="previouseditor">dāna</supplied>-cintāmaṇiyuṁm enisida śrīmad-attiyabb’ arasi
              </p>
              
              <ab>kanda <g type="punctuation" ref="sym:bar">.</g></ab>
              
              <p><supplied reason="lost" evidence="previouseditor">dha</supplied><gap reason="lost" unit="character" quantity="8"/>
                  <lb n="17" break="no"/>ma jina-niḷaya-nivahak’ ellaṁ munnaṁ karuvene māḍisidaḷ sirivurado<supplied reason="lost" evidence="parallel">ḷ</supplied><gap reason="lost" unit="character" quantity="5"/>
                  <lb n="18"/>Intu tanna māḍisida basadiya khaṇḍa-sphuṭita-nava-karmma-vara-pūjehārada<gap reason="lost" unit="character" quantity="4"/>nārttha<gap reason="lost" unit="character" quantity="5"/>
                  <lb n="19"/>śrīmad-āhavamalla-dēvaṁge <supplied reason="lost" evidence="previouseditor">binnapaṁ</supplied> geydu <choice><orig>namaśyaṁ</orig><reg>namasyaṁ</reg></choice> baḍedu <g type="punctuation" ref="sym:bar">.</g>
              </p>
              
              <p>saka-nr̥pa-kalātīta saṁvasara śataṁgaḷ·
                  <lb n="20"/>908 neya sarvvajit-saṁvatsarada phālguṇa-māsada nandīśvarāṣṭamiy-ādityavārad’ andu śrīmad-indrakīrti-dēvara
                  <lb n="21"/>kālaṁ kaḻci māsiyavāḍi nāḍoḷagana gāvuṇḍigana paḷḷiyumaṁ rājamānadoḷ innūṟu mattar ttaḷavr̥<supplied reason="lost" evidence="previouseditor">tti</supplied>
                  <lb n="22" break="no"/>yumaṁ sarvva-bādha-parihāraṁ <choice><orig>namaśyavāgi</orig><reg>namasyavāgi</reg></choice> biṭṭar· <g type="punctuation" ref="sym:doubleBar">.</g>
              </p>
              
              <p>gāvuṇḍigana paḷḷigaṁ taḷavr̥ttiṁga sarvvāya vr̥ddhi
                  <lb n="23"/>Aruvaṇaṁ gadyāṇaṁ panneraḍalaḻa sīme nairitiya deseyoḷ pālvaḷḷaṁ baḍaga
                  <lb n="24"/>pulgila <g type="punctuation" ref="sym:bar">.</g>
              </p>
              
              <p>vāyavyada deseyoḷ vannir hulcikkōl’ allinda mūḍa bele-guḍḍa Adakke baḍaga kavile-vāḍa
                  <lb n="25" break="no"/>da lokkiguṇḍiya baṭṭe baḍaga nirvvari mūḍa sirivurada polada mēre teṁnka pālvaḷḷamē mēre <g type="punctuation" ref="sym:Bar">.</g>
              </p>
              
              <ab>taḷavr̥ttiya
                  <lb n="26"/>sīme
              </ab>
              
              <p>baḍagan’ ariya paḷḷaṁ mūḍa bariya paḷḷaṁ teṁka Ā <gap reason="lost" unit="character" quantity="3"/>lada mēre paḍuvalkāyigēśvarada pola
                  <lb n="27" break="no"/>da mēre <g type="punctuation" ref="sym:doubleBar">.</g>
              </p>
              
              <ab>sirivuradal intu tōṭaṁ</ab>
              
              <lg n="1" met="anuṣṭubh" xml:lang="san-Latn">
                  <l n="a">svadattaṁ para<supplied reason="lost" evidence="parallel"/>dattaṁ vā</l>
                  <l n="b"><supplied reason="lost" evidence="parallel">yo</supplied>harēti <choice><sic>vasundarā</sic><corr>vasundarām</corr></choice></l>
                  <l n="c">ṣaṣṭirvvarṣa saha<lb n="28" break="no"/>srāṇi</l>
                  <l n="d">viṣṭāyāṁ jāyatē krimiḥ <g type="punctuation" ref="sym:doubleBar">.</g></l>
              </lg>
              
              <lg n="2" met="śālinī" xml:lang="san-Latn">
                  <l n="a">bahuvir vvasu<supplied reason="lost" evidence="parallel">dhā bhuktā</supplied></l>
                  <l n="b"><supplied reason="lost" evidence="parallel">rājabhis sā</supplied>garādi<supplied reason="lost" evidence="parallel">bhiḥ</supplied></l>
                  <l n="c">yasya ya<lb n="29" break="no"/>sya yadā bhūmis</l>
                  <l n="d">ta<supplied reason="lost" evidence="parallel">sya</supplied>tasya tadā phaḷa</l>
              </lg>
              
              <ab><gap reason="lost" unit="character" quantity="4"/>ya<gap reason="lost" unit="character" quantity="2"/>maṁgaḷa mahā śrī</ab>
             
         </div>
          
