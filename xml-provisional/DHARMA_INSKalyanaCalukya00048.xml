          <div type="edition" xml:lang="kan-Latn" rendition="class:kannada maturity:middle">
             <p>
                 <lb n="1"/>svasti śrīmat· tailapadēvaṁ pr̥thvī
                 <lb n="2"/>-rājyaṁ geyye Eṟagāri nāḻ-gāmuṇḍa ge
                 <lb n="3" break="no"/>yye Eṟe<supplied reason="undefined" evidence="previouseditor">caṭṭaṁ</supplied> kiṟiya-kaṇnaṁgeyay ūr-gāvu
                 <lb n="4" break="no"/>ṇḍa geyye
             </p>
              
             <p><choice><orig>s</orig><reg>ś</reg></choice>aka-nr̥pa-kāḷātīta-saṁvatsara-<choice><orig>s</orig><reg>ś</reg></choice>a
                 <lb n="5"/>taṁgaḷa 902ṟeneya vi<supplied reason="undefined" evidence="previouseditor">kra</supplied>ma-samvatsarada paurṇna
                 <lb n="6"/>-māseyuṁ Āditya-vāramuṁ hasta-nakṣatramuṁ
                 <lb n="7"/>bālav’ emba karaṇamuṁ pravarttise śrīmat·
                 <lb n="8"/>saṁkayya-bhaṭṭārara kālaṁ kaḻci Ir<choice><unclear>mm</unclear><unclear>pp</unclear></choice>mmatt' akkeya
                 <lb n="9"/>Ura gāmuṇḍaruṁ iḻdu dēvargge koṭṭar
             </p> 
              
             <p>idaṁ kā
                 <lb n="10" break="no"/>d’ ātaṁge aśvamēdha-hiraṇyagarbhada phaḷaṁ
             </p>
              
            <p>idan a
                <lb n="11" break="no"/>ḻid’ āta vāraṇāsi-kurukṣētradoḷ sahasra
                <lb n="12"/>kavileyan aḻida brahmātiy’ akku
            </p>
              
            <p>kiṟiya
               <lb n="13"/>-kaṇnaṁgey irugāmanamūligataṁguḻi 
               <lb n="14" break="no"/>ra biṭṭayyaṁ nandi-maṇḍapada dātārar· <g type="punctuation" ref="sym:bar">.</g> 
            </p>
              
            <lg n="1" met="anuṣṭubh">
                <l n="a"><lb n="15"/>svadattaṁ parada<supplied reason="undefined" evidence="parallel">tta</supplied>ṁ vā</l>
                <l n="b">yō <choice><sic>aruni</sic><corr>harēti</corr></choice> vasundharā<supplied reason="omitted" evidence="parallel">ṁ</supplied></l>
                <l n="c">ṣa<lb n="16" break="no"/>ṣtir-variṣa-sahasrāṇi</l>
                <l n="d">viṣṭāyāṁ jāyatē kri<lb n="17" break="no"/>miḥ</l>
