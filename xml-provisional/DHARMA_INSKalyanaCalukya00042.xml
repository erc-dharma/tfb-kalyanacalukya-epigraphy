      <body>
          <div type="edition" xml:lang="kan-Latn" rendition="class:kannada maturity:middle">
              <div type="textpart" subtype="fragment" n="A">
                      <p>
                          <lb n="1"/>mahīndra-datta-sakala-kṣōṇi-vadhū-maṇḍane <g type="punctuation" ref="sym:bar"></g> sākṣā
                          <lb n="2"/>na-nibhī srī-lokkiguṇḍyāḥvaye jaina sthāna
                          <lb n="3"/>mātrā samarppitaḥ kārita jaina-gēhaḥ
                      </p>
                      
                      <p>
                          <lb n="4"/><g type="symbol" ref="sym:floret">.</g>svasti-samasta-bhuvanāśraya-śrī-pr̥thvī-valla
                          <lb n="5"/>ṭṭāraka-satyāśraya-kula-tiḷaka-cāḷukyā
                          <lb n="6"/>jyam uttarōttarābhivr̥ddhige saluttam ire
                      </p> 
                          
                      <p>tat-pāda pa
                          <lb n="7"/>maṁtrākṣa-paṭalādhipatiyum enisi <g type="punctuation" ref="sym:doubleBar">.</g></p> 
                          
                      <ab>kaṁda <g type="punctuation" ref="sym:doubleBar">.</g> </ab>
                          
                      <p>mallā
                          <lb n="8"/><gap reason="lost" unit="character" quantity="1"/>d' āhavalammana bhujā<supplied reason="lost" evidence="parallel">daṇḍa</supplied>m enisi dhallaṁ negaḻdaṁ
                          <lb n="9"/><gap reason="lost" unit="character" quantity="3"/><supplied reason="lost" evidence="previouseditor">kaṇam er</supplied>diy’ i<supplied reason="lost" evidence="previouseditor">kki</supplied> beṁgi beṟagage tivuḻn' ella
                          <lb n="10"/><gap reason="lost" unit="character" quantity="5"/>mati-raudram adbhutama
                      </p>
              </div>
              
              <div type="textpart" subtype="fragment" n="B">
                  <p>
                      <lb n="1"/>dal urkke dha<gap reason="lost" unit="character" quantity="11" precision="low"/>
                      <lb n="2"/>havamallaṁgaṁ bhēdam uṁṭe vibhavadoḷ adan ēne
                      <lb n="3"/>bhēdaṁ <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>vacanaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Antu maṇdaḷasiddhiyuṁ vivēka
                      <lb n="4"/>kṣameyuṁ muḷisum mitraroḷ amitraroḷ sa
                      <lb n="5"/>ṇḍa mahārṇnavam enisi nāgadēvaṁ negaḻdaṁ vr̥
                      <lb n="6"/><gap reason="lost" unit="character" quantity="1"/>ṇājiradoḷ kaurava-sēneyan tuḻidu geld' ā
                      <lb n="7"/><gap reason="lost" unit="character" quantity="1"/>aṁ vitsaradiṁ bhāvisuv' āgaḷē samarakoḷ gaṇḍaraṁ gaṇḍa
                      <lb n="8"/>nanni mahārṇnavanuṁ kanduka purandaranuṁm enisuva
                      <lb n="9"/>yoḷ andhranaṁ piḍidapeṁ magadhēśanan ikki meṭṭipeṁ
                      <lb n="10"/>ḷikkipeṁ maleva pāṇḍyanan āhavamalla dēvaniṁ pē<gap reason="lost" unit="character" quantity="1"/> 
                  </p>
                  
                  <p>
                      <lb n="11"/><supplied reason="lost" evidence="previouseditor">dē</supplied>va-kula-gagana-gabhasti-māḷige mahāsatī
                      <lb n="12"/><supplied reason="lost" evidence="previouseditor">kā</supplied>madhēnuvuṁ kaṭaka-pavitrey<gap reason="lost" unit="character" quantity="3"/>
                      <lb n="13"/>prabhāvamē doretene <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>v</ab> 
              </div>
              
              <div type="textpart" subtype="fragment" n="C">
                  <ab><lb n="1"/><gap reason="lost" unit="character" quantity="13"/>ji</ab>
                  
                  <ab><lb n="2"/>vr̥ttaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>jinapadapaṁ
                      <lb n="3"/>bbaya magaḷ sacivottaman appa dha
                      <lb n="4"/>sakke bhājanam enip’ attimabbe jina-śā
                      <lb n="5"/>di suṣēṇe-samaṁ śiva<supplied reason="lost" evidence="parallel">dē</supplied>vi-pāṭi lakṣmaṇe
                      <lb n="6"/>sari satyabhāme-toṇe mikka sulōcane
                      <lb n="7"/>kārttiyoḷ <g type="punctuation" ref="sym:doubleBar">.</g>   
                  </p>
                  
                  <ab>kandaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Ā paramēśvarige
                      <lb n="8"/>gra-vijaya-srī-patiyene dharege negaḻda paḍava
                      <lb n="9"/>ye būdiya boṭṭu gaṇdamātugibagi kīrtti kuppa
                      <lb n="10"/><supplied reason="lost" evidence="previouseditor">sau</supplied>caguṇam attiya-paṇn enip' eḍa puṇḍaraṁ tegaḻvudu
                      <lb n="11"/>na <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>vacanaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Intu nanninārāyaṇaṁ samyaktva
                      <lb n="12"/><gap reason="lost" unit="character" quantity="1"/>karpūra-<choice><orig>variṣaṁ</orig><reg>varṣaṁ</reg></choice> catura-caturānanaṁ guṇa-mē
                      <lb n="13"/><milestone n="C" type="gridlike" unit="fragment"/><gap reason="lost" unit="character" quantity="1"/>g-vadhudhamellamāḷey enisi śrīmad-vaḍevaḷḷa<milestone n="D" type="gridlike" unit="fragment"/><supplied reason="lost" evidence="previouseditor">taila</supplied>payyaṁ māsa
                      <lb n="14"/><milestone n="C" type="gridlike" unit="fragment"/>nālvattumaṁ bīḻavṛttiyuman āḷuttam ire <g type="punctuation" ref="sym:bar">.</g>
                  </p>
                  
                  <ab>vṛttaṁ <supplied reason="lost" evidence="parallel"><g type="punctuation" ref="sym:doubleBar">.</g></supplied></ab>
                  
                  <p><milestone n="D" type="gridlike" unit="fragment"/>paramaśrī-jinanātha
                      <lb n="15"/><milestone n="C" type="gridlike" unit="fragment"/>ndōha-bhūsura-jaina-pratimā-vicitra-maṇi<milestone n="D" type="gridlike" unit="fragment"/>-ghaṁṭā-māḷikā-saṁkhye sā
                      <lb n="16"/><milestone n="C" type="gridlike" unit="fragment"/>yevēṟ enipanaṁ nirmmāpaṇaṁ geydu bhūbharadoḷ <milestone n="D" type="gridlike" unit="fragment"/>dharmmaman attiyabbe
                      <lb n="17"/><milestone n="C" type="gridlike" unit="fragment"/>r· <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>vacanaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Ā pavitra-caritra-śāḷi<milestone n="D" type="gridlike" unit="fragment"/>niy enisuva dānaci
                      <lb n="18"/><milestone n="C" type="gridlike" unit="fragment"/>yānantaraṁ śrīmad-ā<supplied reason="lost" evidence="parallel">hava</supplied><milestone n="D" type="gridlike" unit="fragment"/>malla-dēvaṁge biṁnapaṁ ge
                      <lb n="19"/>sāsanamaṁ paḍedu <g type="punctuation" ref="sym:bar">.</g> 
                  </p>
                  
                  <p>śaka-nṛpa-kāḷa-krānta-saṁ
                      <lb n="20"/>ga samvatsaraṁ pravarttise phālguṇa māsada nandīśvarad' adaṣṭame
                      <lb n="21"/>bha lagnōdayadoḷ mahā-dhvaja-mahābhiṣēkotsavadoḷ mahā
                      <lb n="22"/>ttiyabbey arasiyar lokkiguṇḍi mahā-grāmadoḷ tamma gurugaḷ· a
                      <lb n="23"/>kargge basadiyaṁ māḍisiy adarkke taḷavṛttiyendu koṭṭa su
                      <lb n="24"/>dey ent' endoḍe teṁka pāl-vaḷḷaṁ nairitiyoḷ bara vuligeṟeya
                      <lb n="25"/>gal· bareyerada kōḷanuṁ būdivāḻum vāyavyada dese
                      <lb n="26"/>gal ā paḷḷame nīrvvariyāge mūḍal eraḍu paḷḷada <choice><unclear>ka</unclear><unclear>ku</unclear></choice>
                      <lb n="27"/>rkke Aḻuvaṇa gadyāṇaṁ 10 
                  </p>
                  
                  <p>ī maryyādeyaṁ dha
                      <lb n="28"/>yāge <choice><orig>gurukṣētra</orig><reg>kurukṣētra</reg></choice>-<choice><orig>bāṇārāsi</orig><reg>vāraṇāsi</reg></choice> Argghya-tīrtthaṁ bē
                      <lb n="29"/>kavileya koḍuṁ koḷaginoḷaṁ ponnaṁ beḷḷiyoḷaṁ kaṭṭisida
                      <lb n="30"/>rkkaḷig’ ubhaya-mukhi koṭṭa phalaṁ
                  </p>
                  
                  <p>Ida<choice><sic>ṁn</sic><corr>n</corr></choice> aḍeyisid’ ātaṁ I
                      <lb n="31"/>pātakan āgi narakaṁ buguguṁ <g type="punctuation" ref="sym:bar">.</g>
                  </p>
                  
                  <ab>ślōkaṁ</ab>
                  
                  <p>svadattaṁ parada
                      <lb n="32"/><gap reason="illegible" unit="character" quantity="3"/><choice><sic>śa</sic><corr>sa</corr></choice>hasrāṇi viṣṭāyāṁ jāyatē krimiḥ
                  </p>
                  
                  <p>
                      <lb n="33"/>ḷe kāḷe pālanī<choice><sic>yō</sic><corr></corr></choice> bhavadbhi<supplied reason="omitted">ḥ</supplied> sarvān ētā<choice><sic>ṁn</sic><corr>n</corr></choice> bhāvi
                      <lb n="34"/>rāma-bhadraḥ <g type="symbol" ref="sym:floret-complex">.</g><g type="symbol" ref="sym:floret">.</g><g type="symbol" ref="sym:floret">.</g><g type="symbol" ref="sym:floret">.</g>
                  </p>
              </div>
              
              
              
              
              
