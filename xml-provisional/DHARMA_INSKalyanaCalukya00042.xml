          <div type="edition" xml:lang="kan-Latn" rendition="class:kannada maturity:middle">
              <div type="textpart" subtype="fragment" n="A">
                      <p>
                          <lb n="1"/><gap reason="lost" extent="unknown"/>mahīndra-datta-sakala-kṣōṇi-vadhū-maṇḍane <g type="punctuation" ref="sym:bar"></g> sākṣā<gap reason="lost" extent="unknown"/>
                          <lb n="2"/><gap reason="lost" extent="unknown"/>na-nibhī srī-lokkiguṇḍyāḥvaye jaina sthāna<gap reason="lost" extent="unknown"/>
                          <lb n="3"/><gap reason="lost" extent="unknown"/>mātrā samarppitaḥ kārita jaina-gēhaḥ<gap reason="lost" extent="unknown"/>
                      </p>
                      
                      <p>
                          <lb n="4"/><gap reason="lost" extent="unknown"/><g type="symbol" ref="sym:floret">.</g>svasti-samasta-bhuvanāśraya-śrī-pr̥thvī-valla<gap reason="lost" extent="unknown"/>
                          <lb n="5"/><gap reason="lost" extent="unknown"/>ṭṭāraka-satyāśraya-kula-tiḷaka-cāḷukyā<gap reason="lost" extent="unknown"/>
                          <lb n="6"/><gap reason="lost" extent="unknown"/>jyam uttarōttarābhivr̥ddhige saluttam ire
                      </p> 
                          
                      <p>tat-pāda pa<gap reason="lost" extent="unknown"/>
                          <lb n="7"/><gap reason="lost" extent="unknown"/>maṁtrākṣa-paṭalādhipatiyum enisi <g type="punctuation" ref="sym:doubleBar">.</g></p> 
                          
                      <ab>kaṁda <g type="punctuation" ref="sym:doubleBar">.</g> </ab>
                          
                      <p>mallā<gap reason="lost" extent="unknown"/>
                          <lb n="8"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="1"/>d' āhavalammana bhujā<supplied reason="lost" evidence="parallel">daṇḍa</supplied>m enisi dhallaṁ negaḻdaṁ<gap reason="lost" extent="unknown"/>
                          <lb n="9"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="3"/><supplied reason="lost" evidence="previouseditor">kaṇam er</supplied>diy’ i<supplied reason="lost" evidence="previouseditor">kki</supplied> beṁgi beṟagage tivuḻn' ella<gap reason="lost" extent="unknown"/>
                          <lb n="10"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="5"/>mati-raudram adbhutam a<gap reason="lost" extent="unknown"/>
                      </p>
              </div>
              
              <div type="textpart" subtype="fragment" n="B">
                  <p>
                      <lb n="1"/><gap reason="lost" extent="unknown"/>dal urkke dha<gap reason="lost" unit="character" quantity="11" precision="low"/><gap reason="lost" extent="unknown"/>
                      <lb n="2"/><gap reason="lost" extent="unknown"/>havamallaṁgaṁ bhēdam uṁṭe vibhavadoḷ adan ēne<gap reason="lost" extent="unknown"/>
                      <lb n="3"/><gap reason="lost" extent="unknown"/>bhēdaṁ <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>vacanaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Antu maṇdaḷasiddhiyuṁ vivēka<gap reason="lost" extent="unknown"/>
                      <lb n="4"/><gap reason="lost" extent="unknown"/>kṣameyuṁ muḷisum mitraroḷ amitraroḷ sa<gap reason="lost" extent="unknown"/>
                      <lb n="5"/><gap reason="lost" extent="unknown"/>ṇḍa mahārṇnavam enisi nāgadēvaṁ negaḻdaṁ vr̥<gap reason="lost" extent="unknown"/>
                      <lb n="6"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="1"/>ṇājiradoḷ kaurava-sēneyan tuḻidu geld' ā<gap reason="lost" extent="unknown"/>
                      <lb n="7"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="1"/>aṁ vitsaradiṁ bhāvisuv' āgaḷē samarakoḷ gaṇḍaraṁ gaṇḍa<gap reason="lost" extent="unknown"/>
                      <lb n="8"/><gap reason="lost" extent="unknown"/>nanni mahārṇnavanuṁ kanduka purandaranuṁm enisuva<gap reason="lost" extent="unknown"/>
                      <lb n="9"/><gap reason="lost" extent="unknown"/>yoḷ andhranaṁ piḍidapeṁ magadhēśanan ikki meṭṭipeṁ<gap reason="lost" extent="unknown"/>
                      <lb n="10"/><gap reason="lost" extent="unknown"/>ḷikkipeṁ maleva pāṇḍyanan āhavamalla dēvaniṁ pē<gap reason="lost" unit="character" quantity="1"/><gap reason="lost" extent="unknown"/> 
                  </p>
                  
                  <p>
                      <lb n="11"/><gap reason="lost" extent="unknown"/><supplied reason="lost" evidence="previouseditor">dē</supplied>va-kula-gagana-gabhasti-māḷige mahāsatī<gap reason="lost" extent="unknown"/>
                      <lb n="12"/><gap reason="lost" extent="unknown"/><supplied reason="lost" evidence="previouseditor">kā</supplied>madhēnuvuṁ kaṭaka-pavitrey<gap reason="lost" unit="character" quantity="3"/><gap reason="lost" extent="unknown"/>
                      <lb n="13"/><gap reason="lost" extent="unknown"/>prabhāvamē doretene <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>v</ab><gap reason="lost" extent="unknown"/> 
              </div>
              
              <div type="textpart" subtype="fragment" n="C">
                  <ab><lb n="1"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="13"/>ji</ab><gap reason="lost" extent="unknown"/>
                  
                  <ab><lb n="2"/><gap reason="lost" extent="unknown"/>vr̥ttaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>jinapadapaṁ<gap reason="lost" extent="unknown"/>
                      <lb n="3"/><gap reason="lost" extent="unknown"/>bbaya magaḷ sacivottaman appa dha<gap reason="lost" extent="unknown"/>
                      <lb n="4"/><gap reason="lost" extent="unknown"/>sakke bhājanam enip’ attimabbe jina-śā<gap reason="lost" extent="unknown"/>
                      <lb n="5"/><gap reason="lost" extent="unknown"/>di suṣēṇe-samaṁ śiva<supplied reason="lost" evidence="parallel">dē</supplied>vi-pāṭi lakṣmaṇe<gap reason="lost" extent="unknown"/>
                      <lb n="6"/><gap reason="lost" extent="unknown"/>sari satyabhāme-toṇe mikka sulōcane<gap reason="lost" extent="unknown"/>
                      <lb n="7"/><gap reason="lost" extent="unknown"/>kārttiyoḷ <g type="punctuation" ref="sym:doubleBar">.</g>   
                  </p>
                  
                  <ab>kandaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Ā paramēśvarige<gap reason="lost" extent="unknown"/>
                      <lb n="8"/><gap reason="lost" extent="unknown"/>gra-vijaya-srī-patiyene dharege negaḻda paḍava<gap reason="lost" extent="unknown"/>
                      <lb n="9"/><gap reason="lost" extent="unknown"/>ye būdiya boṭṭu gaṇdamātugibagi kīrtti kuppa<gap reason="lost" extent="unknown"/>
                      <lb n="10"/><gap reason="lost" extent="unknown"/><supplied reason="lost" evidence="previouseditor">sau</supplied>caguṇam attiya-paṇn enip' eḍa puṇḍaraṁ tegaḻvudu<gap reason="lost" extent="unknown"/>
                      <lb n="11"/><gap reason="lost" extent="unknown"/>na <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>vacanaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Intu nanninārāyaṇaṁ samyaktva<gap reason="lost" extent="unknown"/>
                      <lb n="12"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="1"/>karpūra-<choice><orig>variṣaṁ</orig><reg>varṣaṁ</reg></choice> catura-caturānanaṁ guṇa-mē<gap reason="lost" extent="unknown"/>
                      <lb n="13"/><milestone n="C" type="gridlike" unit="fragment"/><gap reason="lost" extent="unknown"/><gap reason="lost" unit="character" quantity="1"/>g-vadhudhamellamāḷey enisi śrīmad-vaḍevaḷḷa<milestone n="D" type="gridlike" unit="fragment"/><supplied reason="lost" evidence="previouseditor">taila</supplied>payyaṁ māsa<gap reason="lost" extent="unknown"/>
                      <lb n="14"/><milestone n="C" type="gridlike" unit="fragment"/><gap reason="lost" extent="unknown"/>nālvattumaṁ bīḻavṛttiyuman āḷuttam ire <g type="punctuation" ref="sym:bar">.</g>
                  </p>
                  
                  <ab>vṛttaṁ <supplied reason="lost" evidence="parallel"><g type="punctuation" ref="sym:doubleBar">.</g></supplied></ab>
                  
                  <p><milestone n="D" type="gridlike" unit="fragment"/>paramaśrī-jinanātha<gap reason="lost" extent="unknown"/>
                      <lb n="15"/><gap reason="lost" extent="unknown"/><milestone n="C" type="gridlike" unit="fragment"/>ndōha-bhūsura-jaina-pratimā-vicitra-maṇi<milestone n="D" type="gridlike" unit="fragment"/>-ghaṁṭā-māḷikā-saṁkhye sā<gap reason="lost" extent="unknown"/>
                      <lb n="16"/><milestone n="C" type="gridlike" unit="fragment"/><gap reason="lost" extent="unknown"/>yevēṟ enipanaṁ nirmmāpaṇaṁ geydu bhūbharadoḷ <milestone n="D" type="gridlike" unit="fragment"/>dharmmaman attiyabbe<gap reason="lost" extent="unknown"/>
                      <lb n="17"/><gap reason="lost" extent="unknown"/><milestone n="C" type="gridlike" unit="fragment"/>r· <g type="punctuation" ref="sym:doubleBar">.</g>
                  </p>
                  
                  <ab>vacanaṁ <g type="punctuation" ref="sym:doubleBar">.</g></ab>
                  
                  <p>Ā pavitra-caritra-śāḷi<milestone n="D" type="gridlike" unit="fragment"/>niy enisuva dānaci<gap reason="lost" extent="unknown"/>
                      <lb n="18"/><milestone n="C" type="gridlike" unit="fragment"/><gap reason="lost" extent="unknown"/>yānantaraṁ śrīmad-ā<supplied reason="lost" evidence="parallel">hava</supplied><milestone n="D" type="gridlike" unit="fragment"/>malla-dēvaṁge biṁnapaṁ ge<gap reason="lost" extent="unknown"/>
                      <lb n="19"/><gap reason="lost" extent="unknown"/>śāsanamaṁ paḍedu <g type="punctuation" ref="sym:bar">.</g> 
                  </p>
                  
                  <p>śaka-nṛpa-kāḷa-krānta-saṁ<gap reason="lost" extent="unknown"/>
                      <lb n="20"/><gap reason="lost" extent="unknown"/>ga samvatsaraṁ pravarttise phālguṇa māsada nandīśvarad' adaṣṭame<gap reason="lost" extent="unknown"/>
                      <lb n="21"/><gap reason="lost" extent="unknown"/>bha lagnōdayadoḷ mahā-dhvaja-mahābhiṣēkotsavadoḷ mahā<gap reason="lost" extent="unknown"/>
                      <lb n="22"/><gap reason="lost" extent="unknown"/>ttiyabbey arasiyar lokkiguṇḍi mahā-grāmadoḷ tamma gurugaḷ· a<gap reason="lost" extent="unknown"/>
                      <lb n="23"/><gap reason="lost" extent="unknown"/>kargge basadiyaṁ māḍisiy adarkke taḷavṛttiyendu koṭṭa su<gap reason="lost" extent="unknown"/>
                      <lb n="24"/><gap reason="lost" extent="unknown"/>dey ent' endoḍe teṁka pāl-vaḷḷaṁ nairitiyoḷ bara vuligeṟeya<gap reason="lost" extent="unknown"/>
                      <lb n="25"/><gap reason="lost" extent="unknown"/>gal· bareyerada kōḷanuṁ būdivāḻum vāyavyada dese<gap reason="lost" extent="unknown"/>
                      <lb n="26"/><gap reason="lost" extent="unknown"/>gal ā paḷḷame nīrvvariyāge mūḍal eraḍu paḷḷada <choice><unclear>ka</unclear><unclear>ku</unclear></choice><gap reason="lost" extent="unknown"/>
                      <lb n="27"/><gap reason="lost" extent="unknown"/>rkke Aḻuvaṇa gadyāṇaṁ 10 
                  </p>
                  
                  <p>ī maryyādeyaṁ dha<gap reason="lost" extent="unknown"/>
                      <lb n="28"/><gap reason="lost" extent="unknown"/>yāge <choice><orig>gurukṣētra</orig><reg>kurukṣētra</reg></choice>-<choice><orig>bāṇārāsi</orig><reg>vāraṇāsi</reg></choice> Argghya-tīrtthaṁ bē<gap reason="lost" extent="unknown"/>
                      <lb n="29"/><gap reason="lost" extent="unknown"/>kavileya koḍuṁ koḷaginoḷaṁ ponnaṁ beḷḷiyoḷaṁ kaṭṭisida<gap reason="lost" extent="unknown"/>
                      <lb n="30"/><gap reason="lost" extent="unknown"/>rkkaḷig’ ubhaya-mukhi koṭṭa phalaṁ
                  </p>
                  
                  <p>Ida<choice><sic>ṁn</sic><corr>n</corr></choice> aḍeyisid’ ātaṁ I<gap reason="lost" extent="unknown"/>
                      <lb n="31"/><gap reason="lost" extent="unknown"/>pātakan āgi narakaṁ buguguṁ <g type="punctuation" ref="sym:bar">.</g>
                  </p>
                  
                  <ab>ślōkaṁ</ab>
                  
                  <p>svadattaṁ parada<gap reason="lost" extent="unknown"/>
                      <lb n="32"/><gap reason="lost" extent="unknown"/><gap reason="illegible" unit="character" quantity="3"/><choice><sic>śa</sic><corr>sa</corr></choice>hasrāṇi viṣṭāyāṁ jāyatē krimiḥ<gap reason="lost" extent="unknown"/>
                  </p>
                  
                  <p>
                      <lb n="33"/><gap reason="lost" extent="unknown"/>ḷe kāḷe pālanī<choice><sic>yō</sic><corr></corr></choice> bhavadbhi<supplied reason="omitted">ḥ</supplied> sarvān ētā<choice><sic>ṁn</sic><corr>n</corr></choice> bhāvi<gap reason="lost" extent="unknown"/>
                      <lb n="34"/><gap reason="lost" extent="unknown"/>rāma-bhadraḥ <g type="symbol" ref="sym:floret-complex">.</g><g type="symbol" ref="sym:floret">.</g><g type="symbol" ref="sym:floret">.</g><g type="symbol" ref="sym:floret">.</g><gap reason="lost" extent="unknown"/>
                  </p>
