          <div type="edition" xml:lang="kan-Latn" rendition="class:kannada maturity:middle">
              
              <p>
                  <lb n="1"/>svasti samasta-bhuvanāśraya-srī-pr̥thvī-vallabha-ma<supplied reason="lost" evidence="parallel">hā-rā</supplied>
                  <lb n="2" break="no"/>jādhi-rāja-paramēśvaraṁ parama-bhaṭṭārakaṁ satyāśra<supplied reason="lost" evidence="parallel">ya ku</supplied>
                  <lb n="3" break="no"/>ḷa-tiḷakaṁ cāḷukyābharaṇaṁ śrīmad-āhavamalla-dēvari<gap reason="lost" unit="character" quantity="2"/>
                  <lb n="4"/>rājyam uttarōttarābhivr̥ddhige saluttire
              </p> 
                  
                  <p>tat-pāda-pa<supplied reason="lost" evidence="parallel">ṁkaja</supplied>
                  <lb n="5"/>-bhramaraṁ svasti samadhi-gata-paṁca-mahā-śabda-ma<supplied reason="lost" evidence="previouseditor">hā</supplied><gap reason="lost" unit="character" quantity="2"/>
                  <lb n="6"/>tailapan’ aṁka-kāṟa gajake-balguṇḍa-sāmanta<gap reason="lost" unit="character" quantity="4"/>
                  <lb n="7"/>raṇā-gata vajra-paṁjaraṁ śrīmad-bhīmarasa <supplied reason="lost" evidence="parallel">banavā</supplied>
                  <lb n="8" break="no"/>si-pannir cchāsiramuṁ sāṁtaḷige-sāyiramuṁ ki<gap reason="lost" unit="character" quantity="2"/>
                  <lb n="9" break="no"/>d’ eḻpattam agrahāraṁ savasi-guḍig’ eḻeyuman anụṁga<supplied reason="lost" evidence="parallel">jī</supplied>   
                  <lb n="10" break="no"/>vitavūḷ uttare
              </p>
                      
             <p>tat-pāda-padmōpajīvi samasta-rājya-bha<supplied reason="lost" evidence="parallel">ra-ni</supplied>
                  <lb n="11" break="no"/>rūpita-mahāmātya-padavī virājamānaṁ male-rāja sa<gap reason="lost" unit="character" quantity="2"/>
                  <lb n="12"/>śrīmat-perggaḍe kāḷimayyaṁgaḷ·
             </p>
              
             <p>śaka-varṣa 919 neya hē<supplied reason="lost" evidence="parallel">ma</supplied>
                 <lb n="13" break="no"/>ḷaṁbi-saṁvatsarada<gap reason="lost" unit="character" quantity="4"/>suddha 5 Āditya-vārad’ andu nariya
                 <lb n="14" break="no"/>ḷige nālvattaṟa manneya<gap reason="lost" unit="character" quantity="3"/>kāyimmaṁge biṭṭaṁ pūsi<gap reason="lost" unit="character" quantity="1"/>
                 <lb n="15" break="no"/>vyabhārakke sarvya-virōdha geydoḍ’ ātaṁ tanage kuḍal' illade
                 <lb n="16"/>dēvayyana keyyoḷ nālvattu gadyāṇa ponna koṇḍ’ āta
                 <lb n="17" break="no"/>na mōdala manneya<gap reason="lost" unit="character" quantity="2"/>biṭṭa ka<gap reason="lost" unit="character" quantity="2"/>niṁtar ppudekke sā
                 <lb n="18" break="no"/>kṣi padineṁṭ’ agrahā<gap reason="lost" unit="character" quantity="2"/>ḷurāḷge Eḻpatuṁ nari
                 <lb n="19" break="no"/>yaḷige nālvattum<gap reason="lost" unit="character" quantity="2"/>r' ubhayōnnataṁge baredoṁ
                 <lb n="20"/>sēna-bhōva pole <gap reason="lost" unit="character" quantity="3"/> yya <g type="punctuation" ref="sym:doubleBar">.</g>
             </p>
              
              <p>nidan āvan ōrbbā
                  <lb n="21" break="no"/>nccidan ātaṁ vāraṇa<gap reason="lost" unit="character" quantity="3"/>sāsirbbar ppā
                  <lb n="22" break="no"/>sira kavileyum a<gap reason="lost" unit="character" quantity="4"/>kanakku<gap reason="lost" extent="unknown"/>
                  <lb n="23" break="no"/>ḷakkanu koṭṭa ta
              </p>
              
              
